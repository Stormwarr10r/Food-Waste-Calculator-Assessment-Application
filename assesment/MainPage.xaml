<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="assesment.MainPage">

    <ScrollView>
        <!-- Main layout for the page -->
        <VerticalStackLayout
                Padding="30,0"
                Spacing="12">

            <!-- Title -->
            <Label Text="Enter the food you wasted and its price"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Food name -->
            <Entry x:Name="txtFoodName"
                   Placeholder="e.g., Apple"
                   AutomationId="FoodNameEntry" />

            <!-- Price -->
            <Entry x:Name="txtWasteAmount"
                   Placeholder="0.00"
                   Keyboard="Numeric"
                   AutomationId="PriceEntry" />

            <!-- Day picker (replaces the Entry) -->
            <Picker x:Name="pickerDay"
                    Title="Select day wasted"
                    AutomationId="DayPicker" />

            <!-- Add button -->
            <Button x:Name="btnSubmit"
                    Text="Add to total"
                    SemanticProperties.Hint="Amount wasted"
                    Clicked="OnCalculate"
                    HorizontalOptions="Fill" />

            <!-- List of added items shown above the total -->
            <CollectionView x:Name="cvWasteItems"
                            HeightRequest="180"
                            SelectionMode="None"
                            Margin="2,8">

                <!-- spacing between items -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="Red"
                                               Clicked="OnDeleteItem"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Adds a border around the item -->
                            <Border Padding="8">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Price, StringFormat='${0:F2}'}"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Per-day sub-sections (collapsible) -->
            <StackLayout x:Name="slDaySections" Spacing="8" />

            <!-- Total and warnings -->
            <Label x:Name="lblLetterGrade"
                   Text="Total Wasted for the week: $0.00"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="lblWarning"
                   TextColor="Red"
                   SemanticProperties.HeadingLevel="Level1"/>
            <!--Resets the week amount
            <Button x:Name="btnReset"
                Text="Reset"
                Clicked="OnReset"
                HorizontalOptions="Fill" />
            -->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>